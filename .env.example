# Copy this file to .env and replace placeholder values.
# Never commit the real .env.

FASTAPI_ENV=development
PROJECT_NAME=Jewelry Brand Studio

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Local development email catcher (Mailpit)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=false
SMTP_PORT=1025

# Local PostgreSQL (Docker maps project DB to host port 5433)
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:changethis@localhost:5433/app

# Optional: object storage / AI / Instagram providers (fake providers used when unset)
STORAGE_BACKEND=local
