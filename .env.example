# Copy this file to .env and replace placeholder values.
# Never commit the real .env.

FASTAPI_ENV=development
PROJECT_NAME=Jewelry Brand Studio

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Local development email catcher (Mailpit)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=false
SMTP_PORT=1025

# Local PostgreSQL (Docker maps project DB to host port 5433)
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:changethis@localhost:5433/app

# Optional: object storage / AI / Instagram providers (fake providers used when unset)
STORAGE_BACKEND=local

# Storage: local (default) or s3 (S3-compatible production adapter)
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=/absolute/path/to/private/storage
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=jewelry-brand-studio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# Background worker. Eager mode runs jobs inline (tests/local). Production: false + Redis.
TASKS_EAGER=true
REDIS_URL=redis://localhost:6379

# AI (fake providers are used when AI_PROVIDER=fake or AI_API_KEY is unset)
AI_PROVIDER=fake
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_TEXT_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=gpt-image-1

# Instagram: fake (default) or graph (requires professional account token)
INSTAGRAM_PROVIDER=fake
# INSTAGRAM_GRAPH_BASE=https://graph.facebook.com/v21.0

# OCR for scanned/image-only PDF brand books (optional, paid external calls).
# GPT-6 Luna accepts PDF input directly. Go endpoint:
#   https://opencode.ai/inference/go/openai/v1
# Console pay-as-you-go (recommended for document workloads):
#   https://opencode.ai/inference/openai/v1
OCR_ENABLED=false
OCR_API_BASE=https://opencode.ai/inference/go/openai/v1
OCR_API_KEY=
OCR_MODEL=gpt-6-luna
OCR_MIN_TEXT_CHARS=200
OCR_MAX_PDF_BYTES=20971520
